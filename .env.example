# Переменные, которые читает бот. Они задаются не этим файлом, а блоком
# EnvironmentVariables в plist launchd — здесь они перечислены как шпаргалка
# и как напоминание: токен живёт вне репозитория и в git не попадает.

# Токен бота от @BotFather
TG_TOKEN=
# Ваш числовой id в Telegram (не id бота!) — узнать у @userinfobot
TG_CHAT_ID=
# Папка хранилища Obsidian
VAULT=
# Имя календаря в приложении «Календарь»
CAL_NAME=brain
# Имя списка в приложении «Напоминания»
REM_LIST=brain
